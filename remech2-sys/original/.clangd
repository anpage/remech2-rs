If:
  PathMatch: MW2/.*
CompileFlags:
  Add: [-IMW2/include, -include, MW2/sim_names.h]
Diagnostics:
  UnusedIncludes: None
---
If:
  PathMatch: MW2SHELL/.*
CompileFlags:
  Add: [-IMW2SHELL/include]
---
If:
  PathMatch: MW2SHELL/.*\.(cpp|h)
CompileFlags:
  Add: [-xc++]
---
Diagnostics:
  MissingIncludes: Strict
  Suppress:
    - writable-strings
