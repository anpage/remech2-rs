{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug ReMech2",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/target/debug/remech2",
            "cwd": "${workspaceFolder}/data",
            "preLaunchTask": "build",
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
